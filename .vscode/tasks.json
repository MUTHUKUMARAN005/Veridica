{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "unstage-generated-task-file",
			"type": "shell",
			"command": "git",
			"args": [
				"rm",
				"-f",
				"--cached",
				"--",
				".vscode/tasks.json"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "show-staged-stat",
			"type": "shell",
			"command": "git",
			"args": [
				"diff",
				"--cached",
				"--stat"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "show-staged-status",
			"type": "shell",
			"command": "git",
			"args": [
				"diff",
				"--cached",
				"--name-status"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "commit-project",
			"type": "shell",
			"command": "git",
			"args": [
